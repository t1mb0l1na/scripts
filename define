#!/bin/sh
# define - look up an English word's definition via Wiktionary

if [ $# -eq 0 ] ; then
  echo "Usage: $(basename $0) word" >&2
  exit 1
fi

word="$(echo "$1" | sed 's/ /%20/g')"
result="$(curl -s "https://en.wiktionary.org/api/rest_v1/page/definition/$word")"

if ! printf '%s\n' "$result" | jq -e '.en' >/dev/null 2>&1 ; then
  echo "No definition found for \"$1\"." >&2
  exit 1
fi

printf '%s\n' "$result" | jq -r '.en[] | "\(.partOfSpeech):", (.definitions[].definition)' \
  | sed -e 's|<style[^>]*>[^<]*</style>||g' -e 's/<[^>]*>//g'
